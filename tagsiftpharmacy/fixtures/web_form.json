  "client_script": "frappe.web_form.after_load = function () {\n    const drug_details_field = frappe.web_form.get_field('drug_details');\n    console.log(\"Web Form Loaded\");\n\n    // Make \"name\" field readonly in each grid row\n    if (drug_details_field && drug_details_field.grid) {\n        drug_details_field.grid.wrapper.on('focus', '[data-fieldname=\"name\"] input', function () {\n            $(this).prop('readonly', true);\n        });\n    }\n\n    function handleNdcChange(grid_row, ndc_value) {\n        console.log(\"NDC changed to:\", ndc_value);\n        if (!ndc_value) return;\n\n        frappe.call({\n            method: \"frappe.client.get_value\",\n            args: {\n                doctype: \"Drug\",\n                filters: { name: ndc_value },\n                fieldname: [\"drug_name\", \"class\", \"manufacture\", \"pk_size\"]\n            },\n            callback: function (r) {\n                const row = grid_row.doc;\n\n                if (r.message) {\n                    row.ndc = ndc_value;\n                    row.drug_name = r.message.drug_name;\n                    row.class = r.message.class;\n                    row.manufacturer = r.message.manufacture;\n                    row.package_size = r.message.pk_size;\n                } else {\n                    // NDC not found — clear the fields\n                    row.drug_name = \"\";\n                    row.class = \"\";\n                    row.manufacturer = \"\";\n                    row.package_size = \"\";\n                }\n\n                grid_row.refresh();\n            },\n            error: function (err) {\n                console.error(\"Error fetching drug data for NDC:\", ndc_value, err);\n            }\n        });\n    }\n\n    if (drug_details_field && drug_details_field.grid) {\n        const processedValues = new Map();\n\n        // Debounce function to limit mutation trigger spam\n        const debounce = (func, wait) => {\n            let timeout;\n            return (...args) => {\n                clearTimeout(timeout);\n                timeout = setTimeout(() => func.apply(this, args), wait);\n            };\n        };\n\n        const handleMutations = debounce(function () {\n            const ndcInputs = document.querySelectorAll('[data-fieldname=\"drug_details\"] [data-fieldname=\"ndc\"] input');\n\n            ndcInputs.forEach(function (input) {\n                const $input = $(input);\n                const ndc_value = $input.val();\n                const $row = $input.closest('[data-name]');\n                const row_name = $row.attr('data-name');\n\n                const key = `${row_name}:${ndc_value}`;\n                if (row_name && ndc_value && !processedValues.has(key)) {\n                    processedValues.set(key, true);\n\n                    const grid_row = drug_details_field.grid.get_row(row_name);\n                    if (grid_row) {\n                        grid_row.doc.ndc = ndc_value;\n                        handleNdcChange(grid_row, ndc_value);\n                    }\n                }\n            });\n        }, 200);\n\n        // Start observing DOM mutations on the child table\n        const observer = new MutationObserver(handleMutations);\n        observer.observe(drug_details_field.grid.wrapper[0], {\n            childList: true,\n            subtree: true,\n            attributes: true,\n            attributeFilter: ['value']\n        });\n\n        // Direct event handler for manual changes\n        $(drug_details_field.grid.wrapper).on('keyup change blur', '[data-fieldname=\"ndc\"] input', function () {\n            const $input = $(this);\n            const ndc_value = $input.val();\n            const $row = $input.closest('[data-name]');\n            const row_name = $row.attr('data-name');\n\n            const key = `${row_name}:${ndc_value}`;\n            if (row_name && ndc_value && !processedValues.has(key)) {\n                processedValues.set(key, true);\n\n                const grid_row = drug_details_field.grid.get_row(row_name);\n                if (grid_row) {\n                    grid_row.doc.ndc = ndc_value;\n                    handleNdcChange(grid_row, ndc_value);\n                }\n            }\n        });\n    }\n};\n",
  "condition_json": "[]",
  "custom_css": "[data-doctype=\"Web Form\"] .page_content {\n    max-width: 100% !important;\n    margin: auto;\n}",
