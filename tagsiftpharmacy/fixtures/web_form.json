  "button_label": "Submit",
  "client_script": "frappe.web_form.after_load = function () {\n    // Debug version with console logging\nfrappe.call({\n    method: \"tagsiftpharmacy.tagsiftpharmacy.user.get_user_details_case_insensitive\",\n    callback: function(r) {\n        console.log(\"Custom Method Response:\", r.message);\n\n        if (!r.message || !r.message.name) {\n            console.log(\"User details not found, showing dialog\");\n\n            let d = new frappe.ui.Dialog({\n                title: __(\"User Profile Not Found\"),\n                static: 1,\n                primary_action_label: __(\"Update Profile\"),\n                primary_action: function () {\n                    window.location.href = \"/signup\";\n                }\n            });\n\n            d.fields = [];\n\n            d.$body.html(\n                '<div class=\"text-center\">' +\n                __(\"You need to create a user profile before accessing this form.\") +\n                '</div>'\n            );\n\n            d.$wrapper.find(\".modal-header .close\").remove();\n            d.show();\n        } else {\n            console.log(\"User details found:\", r.message.name);\n            // continue your app logic here\n        }\n    }\n});\n\n\n\n\n\n\n    const drug_details_field = frappe.web_form.get_field('drug_details');\n    console.log(\"Web Form Loaded\");\n\n    // Make \"name\" field readonly in each grid row\n    if (drug_details_field && drug_details_field.grid) {\n        drug_details_field.grid.wrapper.on('focus', '[data-fieldname=\"name\"] input', function () {\n            $(this).prop('hidden', true);\n        });\n    }\n\n    function handleNdcChange(grid_row, ndc_value) {\n        console.log(\"NDC changed to:\", ndc_value);\n        if (!ndc_value) return;\n\n        frappe.call({\n            method: \"frappe.client.get_value\",\n            args: {\n                doctype: \"Drug\",\n                filters: { name: ndc_value },\n                fieldname: [\"drug_name\", \"class\", \"manufacture\", \"pk_size\"]\n            },\n            callback: function (r) {\n                const row = grid_row.doc;\n\n                if (r.message) {\n                    row.ndc = ndc_value;\n                    row.drug_name = r.message.drug_name;\n                    row.class = r.message.class;\n                    row.manufacturer = r.message.manufacture;\n                    row.package_size = r.message.pk_size;\n                    \n                    // Calculate inventory after fetching package size\n                    calculateInventory(grid_row);\n                } else {\n                    // NDC not found — clear the fields\n                    row.drug_name = \"\";\n                    row.class = \"\";\n                    row.manufacturer = \"\";\n                    row.package_size = \"\";\n                }\n\n                grid_row.refresh();\n            },\n            error: function (err) {\n                console.error(\"Error fetching drug data for NDC:\", ndc_value, err);\n            }\n        });\n    }\n\n    // Function to calculate inventory_in_hand\n    function calculateInventory(grid_row) {\n        const row = grid_row.doc;\n        const package_size = parseFloat(row.package_size) || 0;\n        const close_bottle = parseFloat(row.close_bott) || 0;\n        const open_bottle = parseFloat(row.open_bottle) || 0;\n        \n        // Apply the formula: inventory_in_hand = (package_size * close_bottle) + open_bottle\n        row.inventory_on_hand = (package_size * close_bottle) + open_bottle;\n        \n        console.log(\"Calculated inventory:\", row.inventory_on_hand);\n        grid_row.refresh();\n    }\n\n    if (drug_details_field && drug_details_field.grid) {\n        const processedValues = new Map();\n\n        // Improved debounce function with a longer delay\n        const debounce = (func, wait) => {\n            let timeout;\n            return (...args) => {\n                clearTimeout(timeout);\n                timeout = setTimeout(() => func.apply(this, args), wait);\n            };\n        };\n\n        // Create a debounced handler for NDC changes with a 500ms delay\n        const debouncedNdcHandler = debounce(function(grid_row, ndc_value) {\n            handleNdcChange(grid_row, ndc_value);\n        }, 500); // Increased delay to 500ms\n\n        // Create a debounced handler for calculation with a 300ms delay\n        const debouncedCalculator = debounce(function(grid_row) {\n            calculateInventory(grid_row);\n        }, 300);\n\n        const handleMutations = debounce(function () {\n            const ndcInputs = document.querySelectorAll('[data-fieldname=\"drug_details\"] [data-fieldname=\"ndc\"] input');\n\n            ndcInputs.forEach(function (input) {\n                const $input = $(input);\n                const ndc_value = $input.val();\n                const $row = $input.closest('[data-name]');\n                const row_name = $row.attr('data-name');\n\n                const key = `${row_name}:${ndc_value}`;\n                if (row_name && ndc_value && !processedValues.has(key)) {\n                    processedValues.set(key, true);\n\n                    const grid_row = drug_details_field.grid.get_row(row_name);\n                    if (grid_row) {\n                        grid_row.doc.ndc = ndc_value;\n                        debouncedNdcHandler(grid_row, ndc_value);\n                    }\n                }\n            });\n        }, 300); // Slightly increased delay for mutations\n\n        // Start observing DOM mutations on the child table\n        const observer = new MutationObserver(handleMutations);\n        observer.observe(drug_details_field.grid.wrapper[0], {\n            childList: true,\n            subtree: true,\n            attributes: true,\n            attributeFilter: ['value']\n        });\n\n        // Modified event handler for NDC field to use blur (focus out) as primary trigger\n        // and debounced input for convenience\n        $(drug_details_field.grid.wrapper).on('input', '[data-fieldname=\"ndc\"] input', function () {\n            const $input = $(this);\n            const ndc_value = $input.val();\n            const $row = $input.closest('[data-name]');\n            const row_name = $row.attr('data-name');\n\n            if (row_name && ndc_value) {\n                const grid_row = drug_details_field.grid.get_row(row_name);\n                if (grid_row) {\n                    grid_row.doc.ndc = ndc_value;\n                    // Use debounced handler to prevent premature API calls\n                    debouncedNdcHandler(grid_row, ndc_value);\n                }\n            }\n        });\n        \n        // Add definitive trigger on blur (when user leaves the field)\n        $(drug_details_field.grid.wrapper).on('blur', '[data-fieldname=\"ndc\"] input', function () {\n            const $input = $(this);\n            const ndc_value = $input.val();\n            const $row = $input.closest('[data-name]');\n            const row_name = $row.attr('data-name');\n\n            const key = `${row_name}:${ndc_value}`;\n            if (row_name && ndc_value) {\n                const grid_row = drug_details_field.grid.get_row(row_name);\n                if (grid_row) {\n                    grid_row.doc.ndc = ndc_value;\n                    // Immediate handling on blur - user has finished entering\n                    handleNdcChange(grid_row, ndc_value);\n                }\n            }\n        });\n\n        // Modified event handlers for calculation fields\n        $(drug_details_field.grid.wrapper).on('input', \n            '[data-fieldname=\"package_size\"] input, [data-fieldname=\"close_bott\"] input, [data-fieldname=\"open_bottle\"] input', \n            function () {\n                const $input = $(this);\n                const $row = $input.closest('[data-name]');\n                const row_name = $row.attr('data-name');\n\n                if (row_name) {\n                    const grid_row = drug_details_field.grid.get_row(row_name);\n                    if (grid_row) {\n                        // Update the doc with the current field value\n                        const fieldname = $input.closest('[data-fieldname]').attr('data-fieldname');\n                        grid_row.doc[fieldname] = $input.val();\n                        \n                        // Use debounced calculator\n                        debouncedCalculator(grid_row);\n                    }\n                }\n            }\n        );\n        \n        // Definitive calculation on blur\n        $(drug_details_field.grid.wrapper).on('blur', \n            '[data-fieldname=\"package_size\"] input, [data-fieldname=\"close_bott\"] input, [data-fieldname=\"open_bottle\"] input', \n            function () {\n                const $input = $(this);\n                const $row = $input.closest('[data-name]');\n                const row_name = $row.attr('data-name');\n\n                if (row_name) {\n                    const grid_row = drug_details_field.grid.get_row(row_name);\n                    if (grid_row) {\n                        // Update the doc with the current field value\n                        const fieldname = $input.closest('[data-fieldname]').attr('data-fieldname');\n                        grid_row.doc[fieldname] = $input.val();\n                        \n                        // Immediate calculation on blur\n                        calculateInventory(grid_row);\n                    }\n                }\n            }\n        );\n    }\n};",
