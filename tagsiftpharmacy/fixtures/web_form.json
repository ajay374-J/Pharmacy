  "client_script": "frappe.web_form.after_load = function () {\n    const drug_details_field = frappe.web_form.get_field('drug_details');\n    console.log(\"Web Form Loaded\");\n    \n    function handleNdcChange(grid_row, ndc_value) {\n        console.log(\"NDC changed to:\", ndc_value);\n        if (!ndc_value) return;\n        frappe.call({\n            method: \"frappe.client.get\",\n            args: {\n                doctype: \"Item\",\n                name: ndc_value\n            },\n            callback: function (r) {\n                if (r.message) {\n                    const row = grid_row.doc;\n                    row.ndc = ndc_value;\n                    row.drug_name = r.message.item_name;\n                    row.class = r.message.custom_class;\n                    row.manufacturer = r.message.custom_manufacturer;\n                    row.package_size = r.message.custom_package_size;\n                    grid_row.refresh();\n                    console.log(\"Row updated with item info:\", row);\n                }\n            }\n        });\n    }\n    \n    if (drug_details_field && drug_details_field.grid) {\n        // Create a map to track processed values to avoid duplicate processing\n        const processedValues = new Map();\n        \n        // Set up a MutationObserver to watch for changes\n        const observer = new MutationObserver(function(mutations) {\n            mutations.forEach(function(mutation) {\n                if (mutation.type === 'attributes' || mutation.type === 'childList') {\n                    // Find all NDC fields currently in the DOM\n                    const ndcInputs = document.querySelectorAll('[data-fieldname=\"drug_details\"] [data-fieldname=\"ndc\"] input');\n                    \n                    ndcInputs.forEach(function(input) {\n                        const $input = $(input);\n                        const ndc_value = $input.val();\n                        const $row = $input.closest('[data-name]');\n                        const row_name = $row.attr('data-name');\n                        \n                        // Create a unique key for this row and value\n                        const key = `${row_name}:${ndc_value}`;\n                        \n                        // Only process if we haven't seen this value for this row before\n                        if (row_name && ndc_value && !processedValues.has(key)) {\n                            processedValues.set(key, true);\n                            \n                            const grid_row = drug_details_field.grid.get_row(row_name);\n                            if (grid_row) {\n                                // Update manually and trigger the handler\n                                grid_row.doc.ndc = ndc_value;\n                                handleNdcChange(grid_row, ndc_value);\n                            }\n                        }\n                    });\n                }\n            });\n        });\n        \n        // Start observing the grid container\n        observer.observe(drug_details_field.grid.wrapper[0], {\n            childList: true,\n            subtree: true,\n            attributes: true,\n            attributeFilter: ['value']\n        });\n        \n        // Also add direct event handlers for immediate feedback\n        $(drug_details_field.grid.wrapper).on('change blur', '[data-fieldname=\"ndc\"] input', function() {\n            const $input = $(this);\n            const ndc_value = $input.val();\n            const $row = $input.closest('[data-name]');\n            const row_name = $row.attr('data-name');\n            \n            if (row_name) {\n                const grid_row = drug_details_field.grid.get_row(row_name);\n                if (grid_row) {\n                    // Create a unique key for this row and value\n                    const key = `${row_name}:${ndc_value}`;\n                    \n                    // Process if not already processed\n                    if (!processedValues.has(key)) {\n                        processedValues.set(key, true);\n                        grid_row.doc.ndc = ndc_value;\n                        handleNdcChange(grid_row, ndc_value);\n                    }\n                }\n            }\n        });\n    }\n};",
